# ============================================
# CareerOS AI - Environment Configuration
# ============================================
# Copy this file to .env and fill in real values
# .env is gitignored - never commit secrets
# ============================================

# Backend Server
BACKEND_HOST=localhost
BACKEND_PORT=8000
BACKEND_URL=http://localhost:8000
DEBUG=false

# Database - Supabase PostgreSQL
DATABASE_URL=postgresql://user:password@localhost:5432/careeros_db
DATABASE_ECHO_SQL=false

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
SUPABASE_JWT_SECRET=your-jwt-secret-here

# Supabase Storage
SUPABASE_STORAGE_BUCKET=careeros-storage
SUPABASE_STORAGE_URL=https://your-project.supabase.co/storage/v1/object

# Redis
REDIS_URL=redis://localhost:6379/0

# Security
SECRET_KEY=your-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# AI/LLM Providers
# Gemini
GEMINI_API_KEY=your-gemini-api-key-here

# OpenAI (optional, for future provider support)
OPENAI_API_KEY=your-openai-api-key-here

# Anthropic (optional, for future provider support)
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# Email - Gmail Integration
GOOGLE_CLIENT_ID=your-google-client-id-here
GOOGLE_CLIENT_SECRET=your-google-client-secret-here
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback

# GitHub Integration
GITHUB_CLIENT_ID=your-github-client-id-here
GITHUB_CLIENT_SECRET=your-github-client-secret-here
GITHUB_REDIRECT_URI=http://localhost:8000/api/v1/auth/github/callback

# Job Discovery Sources
# Add API keys for job sources as integrations are added

# Logging
LOG_LEVEL=INFO

# Frontend
FRONTEND_URL=http://localhost:5173
VITE_API_URL=http://localhost:8000

# CORS
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=60

# Feature Flags
ENABLE_EMAIL_INTEGRATION=false
ENABLE_GITHUB_INTEGRATION=false
ENABLE_JOB_DISCOVERY=false
ENABLE_BROWSER_AUTOMATION=false

# Email Configuration (for system notifications)
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password-here

# Monitoring & Observability
SENTRY_DSN=
ANALYTICS_ENABLED=false

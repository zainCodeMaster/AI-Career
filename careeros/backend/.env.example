# CareerOS AI Backend Environment Configuration
# Copy to .env and edit values before running

# ---------------------------------------------------------------
# Database
# ---------------------------------------------------------------
# Development (SQLite):
# DATABASE_URL=sqlite:///./careeros.db
# Production (PostgreSQL + pgvector):
DATABASE_URL=postgresql+psycopg://careeros:careeros@localhost:5432/careeros

# ---------------------------------------------------------------
# Authentication (REQUIRED - change in production!)
# ---------------------------------------------------------------
SECRET_KEY=your-super-secret-key-change-in-production-min-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ---------------------------------------------------------------
# Frontend CORS
# ---------------------------------------------------------------
FRONTEND_URL=http://localhost:5173

# ---------------------------------------------------------------
# AI Provider (Gemini)
# ---------------------------------------------------------------
# Get your API key from: https://aistudio.google.com/
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-1.5-flash
GEMINI_TEMPERATURE=0.3
GEMINI_MAX_TOKENS=4096
LLM_PROVIDER=auto  # auto | gemini | mock

# ---------------------------------------------------------------
# Vector Store
# ---------------------------------------------------------------
VECTOR_STORE_BACKEND=pgvector  # pgvector | in_memory (tests)

# ---------------------------------------------------------------
# Job Discovery
# ---------------------------------------------------------------
JOB_DISCOVERY_SCHEDULER_ENABLED=true
JOB_DISCOVERY_INTERVAL_MINUTES=60
JOB_DISCOVERY_MAX_RESULTS_PER_SOURCE=200
JOB_DISCOVERY_TIMEOUT_SECONDS=20.0
JOB_DISCOVERY_RETRY_COUNT=2
JOB_DISCOVERY_STALE_DAYS=60
JOB_DISCOVERY_USER_AGENT=CareerOS-Bot/1.0

# ---------------------------------------------------------------
# Career Brain
# ---------------------------------------------------------------
CAREER_BRAIN_CHUNK_SIZE=500
CAREER_BRAIN_CHUNK_OVERLAP=50
CAREER_BRAIN_MAX_CHUNKS_PER_DOC=8

# ---------------------------------------------------------------
# Logging
# ---------------------------------------------------------------
LOG_LEVEL=INFO
